# Le client ET Firebase Admin utilisent firebase-applet-config.json.
# Modifier ce fichier avec la configuration du projet Firebase de l’application.
# Les variables VITE_FIREBASE_* ne sont pas consommées.
# Activer Google dans Firebase Authentication. Email/Mot de passe peut rester désactivé.
# Le backend vérifie les mots de passe ; Firebase fournit seulement la passerelle Firestore.
# Ajouter localhost et armpacademiav2.vercel.app aux domaines autorisés.

# Academia Storage API — 137.184.59.184 (images / vidéos / audios → serveur local, pas S3)
VITE_ACADEMIA_API_URL=https://academia.137.184.59.184.nip.io
# Clé optionnelle côté serveur uniquement
ACADEMIA_API_KEY=
# Usage : import { uploadFile, uploadImage, uploadVideo, uploadAudio } from './lib/academiaStorage'

# Synthèse Vocale Humaine Expressive d'Aïsha (Backend /api/ai/tts)
# Par défaut, le serveur utilise automatiquement les voix neurales HD Expressives (Vivienne HD / Denise Studio) avec synchronisation labiale au millième de seconde.
# Optionnel : ajoutez une clé ElevenLabs (eleven_multilingual_v2) pour activer la voix ElevenLabs en priorité :
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL


# Server only, never prefix with VITE_
FIREBASE_SERVICE_ACCOUNT_JSON=
VITE_ENABLE_DEMO=false

# Codes de double authentification et activation des comptes CGPMP, côté serveur.
RESEND_API_KEY=
AUTH_EMAIL_FROM=ARMP RDC Academia <no-reply@armp-rdc.org>

# JWT applicatif : secret aléatoire de 32 octets minimum, serveur uniquement.
JWT_SECRET=
# Origine exacte du site, utilisée pour les liens et la protection des requêtes.
APP_ORIGIN=https://armpacademiav2.vercel.app

# Optionnel avec ADC : compte de service utilisé pour signer les jetons personnalisés.
# La permission IAM signBlob doit déjà être accordée à l’identité serveur.
FIREBASE_SERVICE_ACCOUNT_ID=

# Cartesia — serveur uniquement, priorité vocale pour tuteur et cours.
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.6
# Vidéo de la tutrice — serveur uniquement. Activer après validation d’un vrai rendu.
SYNC_API_KEY=
SYNC_TUTOR_VIDEO_URL=
SYNC_TUTOR_IMAGE_URL=
SYNC_VIDEO_MODEL=sync-3
SYNC_VIDEO_DAILY_LIMIT=6
TUTOR_VIDEO_ENABLED=false
