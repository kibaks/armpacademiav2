# Configuration publique Firebase : firebase-applet-config.json (client et serveur).
# Le champ firestoreDatabaseId désigne la base nommée utilisée par l’application.

# Activer Google Auth : Firebase Console → Authentication → Sign-in method → Google → Enable
# Ajouter les domaines autorisés : Authentication → Settings → Authorized domains → armpacademiav2.vercel.app, localhost

# Academia Storage API — 137.184.59.184 (images / vidéos / audios → serveur local, pas S3)
VITE_ACADEMIA_API_URL=https://academia.137.184.59.184.nip.io
# Clé optionnelle côté serveur uniquement
ACADEMIA_API_KEY=
# Usage : import { uploadFile, uploadImage, uploadVideo, uploadAudio } from './lib/academiaStorage'

# Synthèse Vocale Humaine Expressive d'Aïsha (Backend /api/ai/tts)
# Par défaut, le serveur utilise automatiquement les voix neurales HD Expressives (Vivienne HD / Denise Studio) avec synchronisation labiale au millième de seconde.
# Optionnel : ajoutez une clé ElevenLabs (eleven_multilingual_v2) pour activer la voix ElevenLabs en priorité :
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL


# Server only, never prefix with VITE_
FIREBASE_SERVICE_ACCOUNT_JSON=
VITE_ENABLE_DEMO=false

# Serveur uniquement : services IA et notifications optionnels
GEMINI_API_KEY=
ARENA_API_KEY=
RESEND_API_KEY=
RESEND_FROM=ARMP RDC Academia <no-reply@armp-rdc.org>
PORT=3000

# Les nouveaux fichiers privés utilisent le bucket storageBucket de firebase-applet-config.json.
# L’identité Firebase Admin doit disposer des droits objet sur ce bucket.
# Activer Identity Platform/TOTP, puis déployer les règles Firestore et Storage.
# npm run configure:mfa : lecture seule ; -- --apply : activation TOTP.
