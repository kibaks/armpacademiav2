rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function requiresSecondFactor() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profile) && 'twoFactorEnabled' in get(profile).data &&
        get(profile).data.twoFactorEnabled == true;
    }

    function hasSecondFactor() {
      let proof = /databases/$(database)/documents/mfaSessions/$(request.auth.token.appSessionId);
      return exists(proof) &&
        get(proof).data.authTime == request.auth.token.appAuthTime &&
        get(proof).data.expiresAt > request.time.toMillis();
    }

    function hasBackendSession() {
      let session = /databases/$(database)/documents/authSessions/$(request.auth.token.appSessionId);
      let account = /databases/$(database)/documents/authAccounts/$(request.auth.uid);
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(session) && get(session).data.uid == request.auth.uid && get(session).data.role == request.auth.token.role &&
        get(session).data.expiresAt > request.time.toMillis() &&
        get(session).data.version == (exists(account) ? get(account).data.version : 0) &&
        (!exists(account) || !('demoExpiresAt' in get(account).data) || get(account).data.demoExpiresAt > request.time.toMillis()) &&
        (request.auth.token.role in ['super_admin', 'dfat_admin', 'formateur'] || !exists(account) || !('initiationExpiresAt' in get(account).data) ||
          ('initiationComplete' in get(account).data && get(account).data.initiationComplete == true) ||
          get(account).data.initiationExpiresAt > request.time.toMillis()) &&
        (!exists(profile) ||
          ((!('disabled' in get(profile).data) || get(profile).data.disabled != true) &&
           (!('role' in get(profile).data) || get(profile).data.role == request.auth.token.role)));
    }

    function isSignedIn() {
      return request.auth != null && 'appSessionId' in request.auth.token &&
        hasBackendSession() && (!requiresSecondFactor() || hasSecondFactor());
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role in ['super_admin', 'dfat_admin'];
    }
    function isTrainer() {
      return isSignedIn() && request.auth.token.role == 'formateur';
    }
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 120 &&
        data.email is string && data.email.size() <= 120 &&
        data.role in ['cgpmp_member', 'ac_agent', 'armp_agent', 'dgcmp_agent', 'pme', 'grande_entreprise', 'societe_civile', 'independant', 'particulier', 'dfat_admin', 'super_admin', 'formateur'];
    }

    function isValidTrainingRequest(data) {
      return data.keys().hasAll(['id', 'applicantEmail', 'moduleId', 'participantsCount', 'status']) &&
        data.id is string && data.id.size() <= 128 &&
        data.applicantEmail is string && data.applicantEmail.size() <= 120 &&
        data.moduleId is string && data.moduleId.size() <= 50 &&
        data.participantsCount is number && data.participantsCount > 0;
    }

    function isValidCgpmpAccountRequest(data) {
      return data.keys().hasAll(['id', 'institution', 'permanentSecretaryName', 'permanentSecretaryEmail', 'status']) &&
        data.id is string && data.id.size() <= 128 &&
        data.institution is string && data.institution.size() <= 150 &&
        data.permanentSecretaryName is string && data.permanentSecretaryName.size() <= 120 &&
        data.permanentSecretaryEmail is string && data.permanentSecretaryEmail.size() <= 120 &&
        data.status is string && data.status.size() <= 80;
    }

    function isValidCourse(data) {
      return data.keys().hasAll(['id', 'code', 'title', 'category']) &&
        data.id is string && data.id.size() <= 128 &&
        data.code is string && data.code.size() <= 50 &&
        data.title is string && data.title.size() <= 250 &&
        data.category is string && data.category.size() <= 80;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['id', 'author', 'content']) &&
        data.id is string && data.id.size() <= 128 &&
        data.author is string && data.author.size() <= 120 &&
        data.content is string && data.content.size() <= 3000;
    }

    function isValidCourseQA(data) {
      return data.keys().hasAll(['id', 'courseId', 'author', 'question']) &&
        data.id is string && data.id.size() <= 128 &&
        data.courseId is string && data.courseId.size() <= 128 &&
        data.author is string && data.author.size() <= 120 &&
        data.question is string && data.question.size() <= 1500;
    }

    function isValidStudioVideo(data) {
      return data.keys().hasAll(['id', 'title', 'blobUrl']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.blobUrl is string && data.blobUrl.size() <= 500;
    }

    function isValidQuizBank(data) {
      return data.keys().hasAll(['id', 'code', 'theme', 'q', 'rep']) &&
        data.id is string && data.id.size() <= 128 &&
        data.code is string && data.code.size() <= 50 &&
        data.theme is string && data.theme.size() <= 120 &&
        data.q is string && data.q.size() <= 1000 &&
        data.rep is string && data.rep.size() <= 1500;
    }

    function isValidAnalyticsReport(data) {
      return data.keys().hasAll(['id', 'reportTitle', 'executiveSummary']) &&
        data.id is string && data.id.size() <= 128 &&
        data.reportTitle is string && data.reportTitle.size() <= 250 &&
        data.executiveSummary is string && data.executiveSummary.size() <= 3000;
    }

    // users: identity and session claims are server-owned. Profiles retain editable
    // display fields, reading progress and notes. Assessment/certificate/timer maps
    // are written by authenticated server transactions only.
    // courseAttempts, courseCertificates, trainerObservations: server-only (default deny).
    // Authentication and privilege claims are assigned by the server only.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // administrative lists go through scoped server endpoints
      allow create: if false; // registration creates profiles on the server
      allow update: if isOwner(userId) && isValidUser(incoming()) && !incoming().diff(resource.data).affectedKeys().hasAny(['id', 'email', 'role', 'disabled', 'twoFactorEnabled', 'certificates', 'certificationsCount', 'completedCourseIds', 'completedModulesCount', 'quizScoresByCourse', 'totalStudyMinutes', 'studyMinutesByCourse', 'studyMinutesByDay', 'studyTimerAt']);
      allow delete: if false;
    }
    match /trainingRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.applicantEmail == request.auth.token.email || isAdmin());
      allow create: if isSignedIn() && isValidId(requestId) && isValidTrainingRequest(incoming()) && incoming().applicantEmail == request.auth.token.email && incoming().status == 'En attente';
      allow update: if isAdmin() && isValidTrainingRequest(incoming());
      allow delete: if isAdmin();
    }
    match /cgpmpAccountRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.permanentSecretaryEmail == request.auth.token.email);
      allow create: if isSignedIn() && isValidId(requestId) && isValidCgpmpAccountRequest(incoming()) && incoming().permanentSecretaryEmail == request.auth.token.email && incoming().status == 'En attente de validation ARMP';
      allow update, delete: if isAdmin();
    }
    match /courses/{courseId} {
      allow read: if true;
      allow create: if (isAdmin() || (isTrainer() && incoming().authorId == request.auth.uid)) && isValidId(courseId) && isValidCourse(incoming());
      allow update: if (isAdmin() || (isTrainer() && resource.data.authorId == request.auth.uid && incoming().authorId == request.auth.uid)) && isValidCourse(incoming());
      allow delete: if isAdmin();
    }
    // Social Feed Posts collection
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().authorId == request.auth.uid && isValidId(postId) && isValidPost(incoming()) && incoming().likes == 0 && incoming().comments == [] && (!('likedBy' in incoming()) || incoming().likedBy == []);
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()) && incoming().authorId == resource.data.authorId && isValidPost(incoming()) && !incoming().diff(resource.data).affectedKeys().hasAny(['likes', 'likedBy', 'comments', 'createdAt']);
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Course Q&A collection
    match /courseQA/{qaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().authorId == request.auth.uid && isValidId(qaId) && isValidCourseQA(incoming());
      allow update: if (isAdmin() || isTrainer()) && isValidCourseQA(incoming()) && incoming().authorId == resource.data.authorId;
      allow delete: if isAdmin();
    }

    // Studio Videos collection
    match /studioVideos/{videoId} {
      allow read: if isSignedIn();
      allow create, update: if (isAdmin() || isTrainer()) && isValidId(videoId) && isValidStudioVideo(incoming());
      allow delete: if isAdmin() || isTrainer();
    }

    // National Quiz Bank collection
    match /quizBank/{questionId} {
      allow read: if isSignedIn();
      allow create, update: if (isAdmin() || isTrainer()) && isValidId(questionId) && isValidQuizBank(incoming());
      allow delete: if isAdmin();
    }

    // Analytics Reports collection
    match /analyticsReports/{reportId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidId(reportId) && isValidAnalyticsReport(incoming());
      allow delete: if isAdmin();
    }

    // Tutor Conversations collection
    match /tutorConversations/{userId} {
      allow get, create, update, delete: if isOwner(userId) || isAdmin();
    }

    // Connection testing doc
    match /test/{testId} {
      allow read: if true;
    }
  }
}
