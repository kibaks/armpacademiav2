[Unit]
Description=ARMP Academia MuseTalk GPU worker
After=network-online.target

[Service]
WorkingDirectory=/opt/MuseTalk
EnvironmentFile=/opt/MuseTalk/academia.env
Environment=OMP_NUM_THREADS=4
ExecStart=/opt/MuseTalk/.venv/bin/uvicorn academia_api:app --host 127.0.0.1 --port 8061 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
